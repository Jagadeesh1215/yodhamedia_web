AUTH_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@yodhamedia.com
ADMIN_PASSWORD_SHA256=replace-with-sha256-hash-of-admin-password
ADMIN_NAME=YodhaMedia Admin
# Prisma uses this Postgres connection string for blog posts and lead submissions.
DATABASE_URL=postgresql://user:password@host:5432/database

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=mailer@example.com
SMTP_PASS=replace-with-smtp-password
SMTP_FROM="YodhaMedia <mailer@example.com>"
CONTACT_TO=info@yodhamedia.com

# Server-side Cloudinary upload settings used by /api/admin/posts routes.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_UPLOAD_PRESET=your-unsigned-preset

NEXT_PUBLIC_BOOKING_URL=https://calendly.com/your-link/consultation
