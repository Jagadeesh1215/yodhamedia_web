generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum BlogPostStatus {
  published
  draft
}

enum LeadType {
  contact
  consultation
}

model BlogPost {
  id              String         @id @default(cuid())
  slug            String         @unique
  category        String
  title           String
  excerpt         String
  date            String
  readTime        String
  icon            String
  tags            Json
  takeaway        String
  content         Json
  author          String         @default("YodhaMedia Editorial")
  coverImage      String?
  coverImagePublicId String?
  status          BlogPostStatus @default(published)
  featured        Boolean        @default(false)
  publishedAt     DateTime
  updatedAt       DateTime       @updatedAt
  seoTitle        String?
  seoDescription  String?
  createdAt       DateTime       @default(now())

  @@index([status, publishedAt])
}

model Lead {
  id            String    @id
  type          LeadType
  name          String
  email         String
  phone         String
  company       String?
  service       String?
  budget        String?
  message       String?
  preferredDate String?
  timezone      String?
  notes         String?
  bookingUrl    String?
  source        String?
  pageUrl       String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([type, createdAt])
}
